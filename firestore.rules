rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Storefront Catalog & Content Management (Live sync for products, categories, banners, etc.)
    match /products/{document=**} {
      allow read, write: if true;
    }
    match /categories/{document=**} {
      allow read, write: if true;
    }
    match /store_banners/{document=**} {
      allow read, write: if true;
    }
    match /top_marquee/{document=**} {
      allow read, write: if true;
    }
    match /banner_marquee/{document=**} {
      allow read, write: if true;
    }
    match /sale_posters/{document=**} {
      allow read, write: if true;
    }
    match /coupons/{document=**} {
      allow read, write: if true;
    }
    match /skin_safe_config/{document=**} {
      allow read, write: if true;
    }
    match /emergency_config/{document=**} {
      allow read, write: if true;
    }
    match /pincodes/{document=**} {
      allow read, write: if true;
    }
    match /store_settings/{document=**} {
      allow read, write: if true;
    }
    match /exchanges/{document=**} {
      allow read, write: if true;
    }

    // Customer Profiles & Orders (Zero-auth SMS login compatibility)
    match /users/{document=**} {
      allow read, write: if true;
    }
    match /orders/{document=**} {
      allow read, write: if true;
    }

    // Admins Collection
    match /admins/{document=**} {
      allow read, write: if true;
    }
    
    // Server-side only Collections (Strictly protected)
    match /otps/{document=**} {
      allow read, write: if false;
    }
    match /rate_limits/{document=**} {
      allow read, write: if false;
    }
  }
}
